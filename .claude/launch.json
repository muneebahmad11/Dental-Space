{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dental-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3000"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "dental-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3100"
      ],
      "port": 3100
    }
  ]
}
