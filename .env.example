# Copy to .env.local for local development; never commit credentials.
# Local Docker credentials below are disposable development credentials only.
# Never reuse them on a hosted or shared database.
DATABASE_URL=postgresql://clinic_runtime:dental_local_runtime_only@127.0.0.1:54329/dental_local
MIGRATION_DATABASE_URL=postgresql://clinic_migrator:dental_local_migration_only@127.0.0.1:54329/dental_local
# Fill these with your Supabase development project configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meta WhatsApp Cloud API: disabled until you configure your own business account.
WHATSAPP_ENABLED=false
WHATSAPP_CLINIC_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Only templates already approved in Meta. Body text parameters only in this slice.
# Example: [{"name":"appointment_reminder","language":"en_US","label":"Appointment reminder","parameters":["Patient name","Clinic name","Appointment time"]}]
WHATSAPP_TEMPLATES_JSON=[]
