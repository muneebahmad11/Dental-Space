# The demo runs with no environment file. Copy to .env.local only for local DB work.
# Local Docker credentials below are disposable development credentials only.
# Never reuse them on a hosted or shared database.
DATABASE_URL=postgresql://clinic_runtime:dental_local_runtime_only@127.0.0.1:54329/dental_local
MIGRATION_DATABASE_URL=postgresql://clinic_migrator:dental_local_migration_only@127.0.0.1:54329/dental_local
# Auth is deferred; fill these only when connecting a Supabase development project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
