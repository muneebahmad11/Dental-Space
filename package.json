{
  "name": "dental-clinic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:billing && pnpm test:operations && pnpm test:expenses && pnpm test:messaging && pnpm test:finance && pnpm test:visits && pnpm test:env && pnpm test:reports && pnpm test:plans && pnpm build",
    "test:billing": "node --experimental-strip-types --test tests/demo-billing.test.ts",
    "test:operations": "node --experimental-strip-types --test tests/demo-operations.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:prepare-runtime": "node --experimental-strip-types scripts/prepare-runtime.ts",
    "env:check": "node --experimental-strip-types scripts/validate-env.ts",
    "test:env": "node --experimental-strip-types --test tests/environment.test.ts",
    "db:verify": "node --experimental-strip-types scripts/verify-database.ts",
    "db:local": "node --experimental-strip-types scripts/local-db.ts",
    "db:verify-patients": "node --experimental-strip-types scripts/verify-patients.ts",
    "test:expenses": "node --experimental-strip-types --test tests/expenses.test.ts",
    "worker:start": "node --experimental-strip-types src/worker/main.ts",
    "test:messaging": "node --experimental-strip-types --test tests/messaging.test.ts",
    "db:verify-messaging": "node --experimental-strip-types scripts/verify-messaging.ts",
    "test:finance": "node --experimental-strip-types --test tests/finance.test.ts",
    "db:verify-finance": "node --experimental-strip-types scripts/verify-finance.ts",
    "test:plans": "node --experimental-strip-types --test tests/plans.test.ts",
    "db:verify-plans": "node --experimental-strip-types scripts/verify-plans.ts",
    "test:reports": "node --experimental-strip-types --test tests/reports.test.ts",
    "test:visits": "node --experimental-strip-types --test tests/visits.test.ts",
    "db:verify-visits": "node --experimental-strip-types scripts/verify-visits.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
